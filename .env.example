# Local PostgreSQL 15/16. Create with:  createdb globetrotter
DATABASE_URL="postgresql://USER@localhost:5432/globetrotter?schema=public"

# What `prisma migrate` connects through. Migrations hold advisory locks that a
# transaction-mode pooler drops, so on a hosted database DATABASE_URL is the
# pooled endpoint and this is the direct one. Locally there is no pooler —
# set it to the same string. Required: Prisma will not start without it.
DIRECT_URL="postgresql://USER@localhost:5432/globetrotter?schema=public"

# Any long random string. Signs the gt_session JWT (HS256).
AUTH_SECRET="change-me-to-a-long-random-string"

# Set to 1 to show the PerfPill (⚡ 12 ms) in the cockpit bar and explore header.
NEXT_PUBLIC_SHOW_PERF=1

# Used for share links, QR codes and OG images.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Email -----------------------------------------------------------------
# Signup sends two messages: a welcome to the new user, and a notification to
# OWNER_EMAIL. Leave SMTP_USER or SMTP_PASS empty and the whole thing turns
# itself off with a log line — signup still works, nothing throws.
#
# For Gmail, SMTP_PASS must be a 16-character App Password (2FA required),
# NOT the account password: https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""

# What recipients see in the From line. Must be the SMTP_USER address, or
# an alias Gmail has verified for it, or the message is rejected.
MAIL_FROM="GlobeTrotter <you@gmail.com>"

# Where the "someone signed up" notification goes.
OWNER_EMAIL="you@gmail.com"
