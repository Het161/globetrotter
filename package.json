{
  "name": "globetrotter",
  "version": "1.0.0",
  "private": true,
  "description": "GlobeTrotter — personalised multi-city trip planner. Odoo x LDCE Hackathon '26.",
  "scripts": {
    "preinstall": "node -e \"if(!(process.env.npm_config_user_agent||'').startsWith('pnpm')){console.error('\\n  This project uses pnpm. Run:  corepack enable && pnpm install\\n');process.exit(1)}\"",
    "postinstall": "prisma generate",
    "dev": "node scripts/clean-appledouble.mjs && next dev",
    "build": "node scripts/clean-appledouble.mjs && prisma generate && next build",
    "start": "next start",
    "lint": "node scripts/clean-appledouble.mjs && eslint",
    "typecheck": "node scripts/clean-appledouble.mjs && tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"prisma/**/*.ts\"",
    "test": "node scripts/clean-appledouble.mjs && vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-generate && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "bench": "tsx scripts/bench.ts",
    "check:images": "tsx scripts/check-images.ts",
    "preview:emails": "tsx scripts/preview-emails.ts",
    "send:test-email": "tsx --env-file=.env --conditions=react-server scripts/send-test-email.ts",
    "build:city-images": "node scripts/build-city-images.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "clean:mac": "node scripts/clean-appledouble.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "^6.16.2",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slider": "^1.2.2",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "date-fns": "^4.1.0",
    "jose": "^5.9.6",
    "lucide-react": "^0.469.0",
    "motion": "^11.15.0",
    "nanoid": "^5.0.9",
    "next": "16.3.2",
    "nodemailer": "^9.0.5",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-globe.gl": "^2.33.2",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.0",
    "server-only": "^0.0.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "three": "^0.185.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "prettier": "^3.4.2",
    "prisma": "^6.16.2",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.28.2"
}
