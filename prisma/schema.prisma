// GlobeTrotter — multi-city trip planner.
// Design notes live in docs/DB-SCHEMA.md (ER diagram + index rationale).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

  // Migrations open a session and hold advisory locks, which a transaction-mode
  // pooler (PgBouncer, Neon's pooled endpoint) will not carry. DATABASE_URL is
  // therefore the pooled endpoint the app queries through, and DIRECT_URL is the
  // unpooled one `prisma migrate` uses.
  //
  // DIRECT_URL is required, not optional — Prisma fails validation if it is
  // missing rather than falling back. Against a plain local Postgres there is
  // no pooler, so set both to the same string.
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum TripStatus {
  PLANNING
  UPCOMING
  ONGOING
  COMPLETED
}

enum ActivityCategory {
  SIGHTSEEING
  FOOD
  CULTURE
  ADVENTURE
  NATURE
  NIGHTLIFE
  SHOPPING
  RELAXATION
}

enum ExpenseCategory {
  TRANSPORT
  STAY
  ACTIVITIES
  MEALS
  OTHER
}

enum CollaboratorRole {
  VIEWER
  EDITOR
}

enum TransportMode {
  FLIGHT
  TRAIN
  BUS
  CAR
  FERRY
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String
  avatarUrl      String?
  language       String   @default("en") // en | hi | gu
  currency       String   @default("INR") // display currency
  role           Role     @default(USER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  trips          Trip[]
  savedCities    SavedCity[]
  resetTokens    PasswordResetToken[]
  collaborations TripCollaborator[]
  events         ActivityEvent[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model City {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  country     String
  countryCode String  @db.Char(2)
  region      String // Europe · Asia · South Asia · Americas · Africa & Middle East · Oceania
  lat         Float
  lng         Float
  costIndex   Int // 1..100, 50 = global average
  popularity  Int // 1..100
  currency    String // local currency code, informational
  timezone    String?
  description String
  imageUrl    String? // optional real photo; Postcard component is the fallback
  avgStayCost Decimal @db.Decimal(10, 2) // USD per night, baseline mid-range
  avgMealCost Decimal @db.Decimal(10, 2) // USD per day

  activities Activity[]
  stops      TripStop[]
  savedBy    SavedCity[]

  @@index([country])
  @@index([region])
  @@index([popularity])
  @@index([costIndex])
}

model Activity {
  id            String           @id @default(cuid())
  cityId        String
  name          String
  category      ActivityCategory
  description   String
  estimatedCost Decimal          @db.Decimal(10, 2) // USD
  durationMin   Int
  imageUrl      String?
  popularity    Int              @default(50)

  city           City           @relation(fields: [cityId], references: [id], onDelete: Cascade)
  stopActivities StopActivity[]

  @@index([cityId, category])
  @@index([cityId, estimatedCost])
  @@index([cityId, durationMin])
}

model Trip {
  id            String     @id @default(cuid())
  userId        String
  name          String
  description   String?
  startDate     DateTime   @db.Date
  endDate       DateTime   @db.Date
  coverImageUrl String?
  budgetLimit   Decimal?   @db.Decimal(12, 2) // USD, optional
  status        TripStatus @default(PLANNING)
  isPublic      Boolean    @default(false)
  shareSlug     String?    @unique
  viewCount     Int        @default(0)
  copiedFromId  String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stops         TripStop[]
  expenses      TripExpense[]
  collaborators TripCollaborator[]
  copiedFrom    Trip?              @relation("TripCopies", fields: [copiedFromId], references: [id], onDelete: SetNull)
  copies        Trip[]             @relation("TripCopies")

  @@index([userId, startDate])
  @@index([userId, updatedAt])
  @@index([isPublic, updatedAt])
}

model TripStop {
  id                  String         @id @default(cuid())
  tripId              String
  cityId              String
  orderIndex          Int // 0-based; NOT unique (reorder rewrites in one transaction)
  arrivalDate         DateTime       @db.Date
  departureDate       DateTime       @db.Date
  stayCostPerNight    Decimal        @db.Decimal(10, 2) // defaults from City.avgStayCost, user-editable
  transportCostToNext Decimal        @default(0) @db.Decimal(10, 2) // to next stop, or home for the last stop
  transportMode       TransportMode?
  notes               String?

  trip       Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  city       City           @relation(fields: [cityId], references: [id])
  activities StopActivity[]

  @@index([tripId, orderIndex])
  @@index([tripId, arrivalDate])
  @@index([cityId])
}

model StopActivity {
  id          String   @id @default(cuid())
  stopId      String
  activityId  String? // null = custom activity
  customName  String?
  date        DateTime @db.Date
  startMinute Int? // minutes from midnight 0..1439; null = unscheduled
  durationMin Int
  cost        Decimal  @db.Decimal(10, 2) // USD, defaults from Activity.estimatedCost
  orderIndex  Int
  notes       String?

  stop     TripStop  @relation(fields: [stopId], references: [id], onDelete: Cascade)
  activity Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@index([stopId, date, orderIndex])
}

model TripExpense {
  id       String          @id @default(cuid())
  tripId   String
  category ExpenseCategory
  label    String
  amount   Decimal         @db.Decimal(10, 2)
  date     DateTime?       @db.Date
  trip     Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, category])
  @@index([tripId, date])
}

model TripCollaborator {
  tripId    String
  userId    String
  role      CollaboratorRole @default(VIEWER)
  createdAt DateTime         @default(now())
  trip      Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tripId, userId])
  @@index([userId])
}

model SavedCity {
  userId    String
  cityId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@id([userId, cityId])
}

// Append-only analytics log. Powers /admin with real aggregates, never hardcoded numbers.
model ActivityEvent {
  id        String   @id @default(cuid())
  userId    String?
  type      String // login · trip.created · stop.added · activity.added · trip.shared · share.viewed · trip.copied
  tripId    String?
  cityId    String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([userId, createdAt])
  @@index([cityId])
}
